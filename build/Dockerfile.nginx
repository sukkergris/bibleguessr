# Production image for the nginx (+ njs) reverse proxy,
# serving the built frontend as static files. Build context is the
# repository root, e.g.:
#   docker build -f build/Dockerfile.nginx -t bibleguessr-nginx .
# Pin the build image to the current Alpine release so it receives the latest
# security fixes instead of relying on the moving, unversioned Alpine tag.
FROM node:24-alpine3.23 AS build-env

# Bring Alpine packages up to date to reduce vulnerabilities in the build image.
RUN apk upgrade --no-cache

WORKDIR /app/bibleguessr

# Copy package files first for better layer caching
COPY ["frontend/package.json", "frontend/package-lock.json", "./"]

RUN npm ci

# Then copy source and build
COPY ["frontend/", "."]

RUN npm run build

# Pin to a specific nginx release on Alpine instead of the moving `alpine`
# tag, so the base image only changes when we bump it here. The njs module
# ships with this image as a dynamic module; nginx.conf loads it.
FROM nginx:1.31.6-alpine AS final

# Bring Alpine packages up to date to reduce vulnerabilities in the runtime image.
RUN apk upgrade --no-cache

# Clean default html
RUN rm -rf /usr/share/nginx/html/*

# Copy static site
COPY --from=build-env /app/bibleguessr/dist /usr/share/nginx/html

# For extension files
RUN mkdir -p /etc/nginx/includes /etc/nginx/conf.d/snippets

# Copy configuration files to /etc/nginx
COPY server-replica/nginx /etc/nginx

EXPOSE 80 443

CMD ["nginx", "-c", "/etc/nginx/nginx.conf", "-g", "daemon off;"]
