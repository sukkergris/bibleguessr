# Production image for the BibleGuessr backend API (F# / ASP.NET Core).
# Build context is the repository root, e.g.:
#   docker build -f build/Dockerfile.api -t bibleguessr-api .
FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build
WORKDIR /src

# Restore first, using only the project files, so dependency restore is
# cached independently of source code changes.
COPY backend/Api/BibleGuessr.Api.fsproj backend/Api/
COPY backend/Domain/BibleGuessr.Domain.fsproj backend/Domain/
RUN dotnet restore backend/Api/BibleGuessr.Api.fsproj

# Now bring in the rest of the source and publish. (Restore runs again here
# rather than passing --no-restore: on Alpine, publish's own dependency
# resolution does not reliably reuse the earlier restore's package set.)
COPY backend/Api/ backend/Api/
COPY backend/Domain/ backend/Domain/
RUN dotnet publish backend/Api/BibleGuessr.Api.fsproj \
    --configuration Release \
    --output /app/publish



FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS runtime
WORKDIR /app

# Run as a non-root user. The data directory is created (and owned by
# apiuser) before VOLUME below, so a fresh named volume inherits that
# ownership; a bind mount must instead be writable by apiuser's UID.
RUN adduser --disabled-password --home /app --gecos '' apiuser \
    && chown -R apiuser /app \
    && mkdir -p /data/bibles \
    && chown apiuser /data/bibles
USER apiuser

COPY --from=build --chown=apiuser /app/publish .

# Ship the public-domain bibelen-dk archive (see NOTICE.md). Copy this one
# file only — never `bibles/` as a whole, which may hold local-only,
# copyrighted test data (see "Bible translation licensing" in CLAUDE.md).
# It is unpacked into the data volume on startup — see
# backend/Api/BibleArchiveUnpacker.fs and docs/web/bible-data-volume/.
COPY --chown=apiuser ["bibles/bibelen-dk/src/Bibelen Files.zip", "/app/bibles/bibelen-dk/src/"]

VOLUME /data/bibles

ARG BUILD_SHA
ARG BUILD_CONTEXT

ENV ASPNETCORE_URLS=http://+:8080 \
    Verses__ArchivePath="/app/bibles/bibelen-dk/src/Bibelen Files.zip" \
    Verses__DataDirectory=/data/bibles \
    BUILD_SHA="${BUILD_SHA}" \
    BUILD_CONTEXT="${BUILD_CONTEXT}"

EXPOSE 8080

ENTRYPOINT ["dotnet", "BibleGuessr.Api.dll"]
