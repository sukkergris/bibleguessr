{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "BibleGuessr": "Warning",
        "BibleGuessr.Api.Reports": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": ["FromLogContext"]
  },
  "AllowedHosts": "*"
}
