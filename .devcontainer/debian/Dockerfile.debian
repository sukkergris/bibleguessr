FROM isuperman/elm-devcontainer-foundation:0.1.10

USER root

RUN apt-get update && apt-get install -y \
    xvfb \
    x11vnc \
    novnc \
    websockify \
    procps \
    gettext-base \
    # Chromium runtime dependencies (for Playwright, e.g. `playwright-cli` /
    # `@playwright/mcp` installed via install-global-npm-tools.sh) — without
    # these, a downloaded Chromium binary fails to launch with
    # "error while loading shared libraries: libnspr4.so: ...".
    libnss3 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libxkbcommon0 \
    libasound2 \
    libgbm1 \
    libcairo2 \
    libpango-1.0-0 \
    libatspi2.0-0 \
    && rm -rf /var/lib/apt/lists/*

USER container-user
RUN curl -fsSL https://claude.ai/install.sh | bash
