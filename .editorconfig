root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,sln,fs,fsproj}]
indent_style = space
indent_size = 4

[*.{js,mjs,ts,tsx,json,css,scss,html,yml,yaml,sh,bash}]
indent_style = space
indent_size = 2

[*.elm]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{xml,props,targets}]
indent_style = space
indent_size = 2
